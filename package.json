{
  "name": "security-insights-editor-tests",
  "private": true,
  "scripts": {
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test --experimental-test-coverage --test-coverage-include=docs/editor/js/validation-accessibility.js --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 tests/editor/*.test.js",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.62.1",
    "js-yaml": "4.3.1"
  }
}
